# AI provider keys — the proxy (api/tutor.js) falls back to these per-provider env vars when the
# learner hasn't entered a bring-your-own key in the Settings screen. Groq is the default provider.
# These are server-only: never VITE_-prefixed, never reach the client bundle.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Supabase (accounts + progress, spec §4/§5). Unlike the keys above, these ARE meant to reach the
# client bundle — the VITE_ prefix is required for that, and the publishable key is safe to ship
# client-side by design; Row Level Security on the `profiles` table is the real security boundary.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# CLI/migration-only (supabase link / db push) — never read by the app itself.
SUPABASE_DATABASE_PASSWORD=